# --- Project-wide ignores ---
# Language-specific build artifacts live in their own subfolder .gitignore
# (e.g. cpp/.gitignore). This file is for things that apply to the whole repo.

# Datasets (large; not versioned)
datasets/

# Scratch / temporary working files
temp/

# Editor / IDE config (machine-specific)
.vscode/

# OS files
.DS_Store
Thumbs.db
